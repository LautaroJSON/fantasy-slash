mouse_filter = 2

[node name="Background" type="ColorRect" parent="BarFrame/Bar"]
layout_mode = 0
mouse_filter = 2

[node name="Trail" type="ColorRect" parent="BarFrame/Bar"]
layout_mode = 0
mouse_filter = 2

[node name="Fill" type="ColorRect" parent="BarFrame/Bar"]
layout_mode = 0
mouse_filter = 2

[node name="HealthLabel" type="Label" parent="BarFrame/Bar"]
