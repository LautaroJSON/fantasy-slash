[gd_scene format=3]

[ext_resource type="Script" path="res://ui/main_menu.gd" id="1_script"]
[ext_resource type="Resource" path="res://data/classes/class_catalog.tres" id="2_class_catalog"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")
game_scene_path = "res://levels/arena/arena.tscn"
class_catalog = ExtResource("2_class_catalog")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.1, 0.12, 0.16, 1)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Layout" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Title" type="Label" parent="Center/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 64
text = "FANTASY SLASH"
horizontal_alignment = 1

[node name="MainPanel" type="VBoxContainer" parent="Center/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 16

[node name="PlayButton" type="Button" parent="Center/Layout/MainPanel"]
