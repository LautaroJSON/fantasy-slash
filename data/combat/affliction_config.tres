[gd_resource type="Resource" script_class="AfflictionConfig" format=3]

[ext_resource type="Script" path="res://resources/affliction_config.gd" id="1_script"]
[ext_resource type="Material" path="res://materials/health_bar_background_material.tres" id="2_background"]
[ext_resource type="Material" path="res://materials/afflictions/affliction_flash_material.tres" id="3_flash"]

[resource]
script = ExtResource("1_script")
max_types = 3
threshold = 100.0
