[resource]
script = ExtResource("1_script")
title = "Envainar"
description = "Mantené para cargar con la katana envainada
(carga completa en 3 s). Al soltar, desenvainás
con un tajo diagonal: 30 de daño + 50 % de tu daño,
del 30 % al 100 % según la carga. Puede ser crítico
y empuja a los que te rodean. Cargando, te movés
lento y recibís la mitad de daño. Enfriamiento: 8 s"
behavior = ExtResource("3_behavior")
base_damage = 30.0
attack_scaling = 0.5
cooldown = 8.0
hit_range = 6.0
hit_width = 1.6
cast_duration = 0.5
min_cooldown = 8.0
min_cast_duration = 0.5
charge_time = 3.0
min_charge_time = 1.5
interrupts_dash = true
dash_cancels_cast = true
shows_hit_impact = true
upgrades = Array[ExtResource("2_upgrade_script")]([ExtResource("4_damage"), ExtResource("5_charge_speed")])
unique_upgrades = Array[ExtResource("6_unique_script")]([ExtResource("7_wind_step"), ExtResource("8_zanshin"), ExtResource("9_nuki"), ExtResource("10_tsubame")])
affliction_scale = 2.0
