[resource]
script = ExtResource("1_script")
title = "Giro"
description = "Girás con el mandoble durante 3 s
golpeando a todos a tu alrededor
en cada vuelta. Podés moverte lento.
8 de daño + 15 % de tu daño por vuelta.
Radio: 2.5 m · Enfriamiento: 9 s"
