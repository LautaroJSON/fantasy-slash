[resource]
script = ExtResource("1_script")
title = "Swift Strike"
description = "Esprintás hacia el enemigo más cercano
rebanando a todos en el camino.
12 de daño + 10 % de tu daño.
Recorrido: 6 m · Enfriamiento: 6 s"
slot = 0
behavior = ExtResource("3_behavior")
base_damage = 12.0
attack_scaling = 0.1
cooldown = 6.0
hit_range = 6.0
hit_width = 1.2
cast_duration = 0.3
min_cooldown = 1.5
min_cast_duration = 0.12
upgrades = Array[ExtResource("2_upgrade_script")]([ExtResource("4_damage"), ExtResource("5_scaling"), ExtResource("6_cooldown"), ExtResource("7_range"), ExtResource("8_width"), ExtResource("9_sprint_speed")])
unique_upgrades = Array[ExtResource("10_unique_script")]([ExtResource("11_reset"), ExtResource("12_execute")])
