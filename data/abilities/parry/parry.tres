[resource]
script = ExtResource("1_script")
title = "Parry"
description = "Levantás el escudo 0.35 s: anula los golpes de frente.
Si parás algo, respondés con una estocada:
20 + 30 % de tu daño, invulnerable,
y el enfriamiento baja a 1.5 s.
Si no, quedás expuesto 0.4 s.
Enfriamiento: 5 s"
behavior = ExtResource("3_behavior")
base_damage = 20.0
attack_scaling = 1.0
cooldown = 5.0
hit_range = 3.0
hit_width = 1.2
cast_duration = 0.4
min_cooldown = 0.1
min_cast_duration = 0.35
interrupts_dash = true
dash_cancels_cast = true
shows_hit_impact = true
upgrades = Array[ExtResource("2_upgrade_script")]([ExtResource("4_cooldown"), ExtResource("5_window")])
unique_upgrades = Array[ExtResource("6_unique_script")]([ExtResource("8_riposte"), ExtResource("9_duel")])
affliction_scale = 2.0
