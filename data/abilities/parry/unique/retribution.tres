[gd_resource type="Resource" script_class="AbilityUniqueUpgradeData" format=3]

[ext_resource type="Script" path="res://resources/ability_unique_upgrade_data.gd" id="1_script"]
[ext_resource type="Script" path="res://resources/value_format.gd" id="2_format"]

[sub_resource type="Resource" id="Format_percent"]
script = ExtResource("2_format")
format = "%.0f %%"
multiplier = 100.0

[resource]
