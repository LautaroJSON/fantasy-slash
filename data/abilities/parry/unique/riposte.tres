[gd_resource type="Resource" script_class="AbilityUniqueUpgradeData" format=3]

[ext_resource type="Script" path="res://resources/ability_unique_upgrade_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"riposte"
max_level = 1
title = "Contragolpe"
description = "La primera parada de cada uso renueva el enfriamiento
y la estocada pasa a ser la Estocada mejorada:
el tiempo se congela y barrés a todos a tu alrededor
(360°, +30 % de alcance, 150 % de un golpe básico).
Sos inmortal durante el golpe"
