[gd_resource type="Resource" script_class="StageData" format=3]

[ext_resource type="Script" path="res://resources/stage_data.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://levels/stages/arena/arena_stage.tscn" id="2_scene"]
[ext_resource type="Script" path="res://resources/enemy_spawn_entry.gd" id="3_spawn_script"]
[ext_resource type="Resource" path="res://data/enemies/spawn/grunt_spawn.tres" id="4_grunt"]
[ext_resource type="Resource" path="res://data/enemies/spawn/charger_spawn.tres" id="5_charger"]
[ext_resource type="Resource" path="res://data/enemies/spawn/harasser_spawn.tres" id="6_harasser"]
[ext_resource type="Resource" path="res://data/enemies/spawn/leaper_spawn.tres" id="7_leaper"]
[ext_resource type="Resource" path="res://data/enemies/spawn/shieldbearer_spawn.tres" id="8_shieldbearer"]
[ext_resource type="Script" path="res://resources/boss_challenge_data.gd" id="9_challenge_script"]
[ext_resource type="Resource" path="res://data/enemies/boss_challenges/titan.tres" id="10_titan"]
[ext_resource type="Resource" path="res://data/enemies/boss_challenges/colmena.tres" id="11_colmena"]
[ext_resource type="Resource" path="res://data/enemies/boss_challenges/verdugo.tres" id="12_verdugo"]
[ext_resource type="Resource" path="res://data/enemies/boss_challenges/king.tres" id="13_king"]
