[resource]
script = ExtResource("1_script")
id = &"arena"
display_name = "Arena"
subtitle = "El último círculo"
scene = ExtResource("2_scene")
regular_waves = 10
enemy_types = Array[ExtResource("3_spawn_script")]([ExtResource("4_grunt"), ExtResource("5_charger"), ExtResource("6_harasser"), ExtResource("7_leaper"), ExtResource("8_shieldbearer")])
boss_challenges = Array[ExtResource("9_challenge_script")]([ExtResource("10_titan"), ExtResource("11_colmena"), ExtResource("12_verdugo"), ExtResource("13_king")])
portal = ExtResource("14_portal")
layout = ExtResource("15_layout")
