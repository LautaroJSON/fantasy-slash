[resource]
script = ExtResource("1_script")
max_bars = 2
bar_size = Vector2(520, 18)
spacing = 6
title_format = "%s  lv. %d"
health_format = "%d / %d"
fill_color = Color(0.85, 0.1, 0.1, 1)
trail_color = Color(0.45, 0.03, 0.03, 1)
background_color = Color(0.12, 0.08, 0.08, 1)
shake_amplitude_px = 6.0
debuff_icon_size_px = 28.0
debuff_spacing_px = 4
max_debuff_icons = 8
status_icon = ExtResource("3_status_icon")
health_bar_config = ExtResource("2_health_bar_config")
affliction_config = ExtResource("4_affliction_config")
