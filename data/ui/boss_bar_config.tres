[gd_resource type="Resource" script_class="BossBarConfig" format=3]

[ext_resource type="Script" path="res://resources/boss_bar_config.gd" id="1_script"]
[ext_resource type="Resource" path="res://data/ui/enemy_health_bar_config.tres" id="2_health_bar_config"]
